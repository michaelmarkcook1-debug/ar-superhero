# AnalystGenius intelligence API (server-side only; never exposed to the browser)
# Base URL includes the /api/v1 prefix.
AG_API_BASE="https://ag-api-dev-verdant-echo-2983.fly.dev/api/v1"
# Read-only API key, sent upstream as X-API-Key. Required for live data;
# without it the app serves /api/ag/* as 503 and the UI falls back to demo data.
AG_API_KEY=""

# Durable deck library (optional). Postgres connection string — e.g. the
# Supabase "Transaction pooler" URI. When unset, the library uses local SQLite
# (ephemeral on the demo host: resets on cold start).
DECK_DB_URL=""
